# Django Core Settings
DEBUG=True
SECRET_KEY=django-insecure-change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Docker Compose Host Ports (collision-free defaults)
APP_PORT=8088

# PostgreSQL Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=phonebook_db
DB_USER=postgres
DB_PASSWORD=secretpassword
DB_HOST=localhost
DB_PORT=5433
CONN_MAX_AGE=60

# Security Cookies for Local HTTP Development
# Note: config/settings/production.py hardcodes SESSION_COOKIE_SECURE=True,
# CSRF_COOKIE_SECURE=True, and SECURE_SSL_REDIRECT=True regardless of .env.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
